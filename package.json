{
  "name": "light-takehome-challenge",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "data:build": "node --import tsx scripts/build-energy-data.ts",
    "predev": "npm run data:build",
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "prebuild": "npm run data:build",
    "build": "vite build",
    "preview": "vite preview",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check .",
    "pretypecheck": "npm run data:build",
    "typecheck": "npm run generate-routes && tsc --noEmit",
    "pretest": "npm run data:build",
    "test": "node --import tsx --test scripts/*.test.ts",
    "build:vercel": "NITRO_PRESET=vercel npm run build",
    "start": "node .output/server/index.mjs"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.40",
    "@tanstack/react-start": "1.168.59",
    "csv-parse": "^7.0.3",
    "lucide-react": "^1.48.0",
    "nitro": "3.0.260610-beta",
    "openai": "^7.23.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.10.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "vite": "^8.0.0"
  },
  "version": "0.1.0",
  "description": "My Energy Story — a Light take-home challenge built with TanStack Start",
  "engines": {
    "node": ">=22.12.0 <23"
  }
}
